{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cria",
  "version": "0.1.0-alpha",
  "identifier": "io.cria.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "pnpm vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cria",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/icon_idle.png"
    ],
    "category": "Productivity",
    "shortDescription": "Native Vikunja client",
    "longDescription": "Offline-capable cross-platform desktop client for Vikunja."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://pocketcoder.github.io/cria/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyN0Q4REMzRTVGMjc1QkEKUldTNmRmTGx3NDE5MHRwQjVOVkdMOEJINnhJTFhnU21xN2pjQ2c4U3psYU43MEcxTURLazJLWTMK"
    }
  }
}
