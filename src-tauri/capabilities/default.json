{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Shared capabilities for all platforms (desktop + iOS/Android): local DB, networking, notifications, deep links, external links, OS info.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-start-dragging",
    "core:window:allow-set-badge-count",
    "core:path:default",
    "core:resources:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "deep-link:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*/**" },
        { "url": "http://127.0.0.1:*/**" },
        { "url": "https://**" }
      ]
    },
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://**" },
        { "url": "http://**" },
        { "url": "mailto:**" }
      ]
    },
    "os:default"
  ]
}
