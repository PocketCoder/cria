<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required so the shopping-list photo importer can open the camera / photo
	     library. iOS terminates the app (SIGABRT) if either picker is shown
	     without its usage-description string. Tauri merges this file into the
	     generated iOS Info.plist at build time. -->
	<key>NSCameraUsageDescription</key>
	<string>Cria uses the camera to photograph a shopping list and turn it into tasks.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Cria reads a photo you choose to turn a shopping list into tasks.</string>
	<!-- Ramble's live dictation (Web Speech API in the webview) needs both. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Cria listens while you ramble so it can turn what you say into tasks.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Cria transcribes your speech to turn it into tasks.</string>
	<!-- On-device AI calls run as BGContinuedProcessingTasks so they survive the
	     user switching apps (system progress Live Activity). Identifiers are
	     generated per call under this prefix; see swift/CriaAI/Background.swift. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).ai.*</string>
	</array>
</dict>
</plist>
