{
  "name": "cria",
  "private": true,
  "version": "0.15.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:release-id": "tauri dev",
    "build": "tsc --noEmit && vite build && tauri build",
    "vite": "vite",
    "vite:build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "bump": "./scripts/bump.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "soak": "node scripts/soak/soak.mjs",
    "generate:api:v2": "VK_URL=${VK_URL:-https://try.vikunja.io} sh -c 'curl -sL $VK_URL/api/v2/openapi-3.0.json -o /tmp/vikunja-openapi-v2.json && openapi-typescript /tmp/vikunja-openapi-v2.json -o src/api/schema.v2.ts'",
    "generate:api": "VK_URL=${VK_URL:-https://try.vikunja.io} sh -c 'curl -sL $VK_URL/api/v1/docs.json -o /tmp/vikunja-swagger.json && npx -y swagger2openapi@7 /tmp/vikunja-swagger.json -o /tmp/vikunja-openapi.json && openapi-typescript /tmp/vikunja-openapi.json -o src/api/schema.ts'",
    "clean": "rm -rf dist src-tauri/target",
    "clean:all": "rm -rf dist src-tauri/target node_modules"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/onest": "^5.3.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tanstack/react-query": "^5.104.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-haptics": "^2.4.2",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "chrono-node": "^2.10.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cria": "link:",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^0.460.0",
    "nanoid": "^5.1.15",
    "openapi-fetch": "^0.17.0",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  }
}
